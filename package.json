{
  "name": "vue-dev-tools-accessibility-ui",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "rm -r -f ./node_modules/.vite && rm -r -f ./node_modules/.vite-temp && npm run dev",
    "dev": "vite --port 5500",
    "build": "vite build",
    "preview": "npm run build && vite preview --port 4173",
    "test": "cross-env TZ=America/New_York vitest run --coverage",
    "unit": "cross-env TZ=America/New_York vitest --coverage",
    "lint": "eslint --ext .js,.vue src tests vite.config.js eslint.config.js",
    "fix": "npm run lint -- --fix",
    "proto": "proto pin node latest --resolve --tool-native && proto pin npm latest --resolve --tool-native && git status",
    "outdated": "npm outdated"
  },
  "ManifestComments": [],
  "dependencies": {
    "color-contrast-picker": "^1.0.8",
    "highlight.js": "^11.12.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.startcase": "^4.4.0",
    "normalize.css": "^8.0.1",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-doxen": "^0.13.4",
    "vue-options-api-constants-plugin": "^1.0.3",
    "vue-router": "^5.3.1",
    "vue3-snapshot-serializer": "^2.13.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-tjw-base": "^5.0.0",
    "eslint-config-tjw-import-x": "^1.0.1",
    "eslint-config-tjw-jest": "^4.0.0",
    "eslint-config-tjw-vue": "^4.0.1",
    "eslint-import-resolver-vite": "^2.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.3",
    "vue-dev-tools-accessibility": "^0.5.5"
  },
  "repository": "https://github.com/vue-dev-tools-accessibility/v0",
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.0"
    }
  }
}
